    "license": "GPL-2.0-only",
    "authors": [
        { "name": "A. Bakkeboe", "role": "Author" },
        { "name": "Brookins Consulting", "role": "Contributor" },
        { "name": "7x", "homepage": "https://se7enx.com", "email": "info@se7enx.com", "role": "Maintainer" }
    ],
    "support": {
        "issues": "https://github.com/se7enxweb/AdminAid/issues",
        "source": "https://github.com/se7enxweb/AdminAid"
    },
    "require": {
        "php": ">=8.0",
        "se7enxweb/exponential-legacy-installer": "*"
    },
    "extra": {
        "ezpublish-legacy-extension-name": "adminaid",
        "installer-name": "adminaid"
    }
}
